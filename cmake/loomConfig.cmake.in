@PACKAGE_INIT@

# The Loom's consumer surface. Consuming this package gives you the substrate that is Loom's
# forever — loom::core (values, schemas, the gate) and loom::switchboard (the live boundary) —
# with the same target spellings the in-tree ALIASes use, so a sibling-source override is a
# drop-in replacement for this package.

include("${CMAKE_CURRENT_LIST_DIR}/loomTargets.cmake")

# The weave-authoring surface: loom_weave_build_contract(<target>), which applies
# whatever this platform and compiler require for a loadable weave's statics to live
# and die with their own image (KERN-05).
#
# It ships in EVERY package, including one built without loom::kernel, for the same
# reason the kernel's headers do: what a consumer can AUTHOR is not gated on what this
# particular install can HOST. `if(TARGET loom::kernel)` remains the honest question
# for hosting, and the function records what it actually imposed on each target in the
# target's LOOM_WEAVE_BUILD_CONTRACT property.
include("${CMAKE_CURRENT_LIST_DIR}/loom-weave.cmake")

# THE PROGRAMS THIS INSTALL CAN RUN, named for a consumer's own tests and tools -- never a link
# line, and never a path a consumer should rebuild from knowing this package's layout.
#
#   LOOM_HOST_PROGRAM     the installed host, `loom-host` (docs/guides/running-loom.md).
#   LOOM_SESSION_TOOLS    TRUE where the session tooling was built and installed
#                         (docs/guides/sessions.md); FALSE otherwise -- the honest question, as
#                         `if(TARGET loom::kernel)` is for hosting.
#   LOOM_RUNS_ARTIFACT    with the tooling: the run manager a session host boots.
#   LOOM_SESSION_RUNTIME  with the tooling: the directory holding the `loom_session` Python
#                         package, which is what PYTHONPATH names.
#
# Each path is checked as it is set, so a package missing what it claims fails the consumer's
# configure in words instead of reaching its tests.
set_and_check(LOOM_HOST_PROGRAM "@PACKAGE_LOOM_HOST_INSTALL_DIR@/loom-host@CMAKE_EXECUTABLE_SUFFIX@")
set(LOOM_SESSION_TOOLS @LOOM_SESSION_TOOLS_INSTALLED@)
if(LOOM_SESSION_TOOLS)
    set_and_check(LOOM_RUNS_ARTIFACT
        "@PACKAGE_LOOM_SESSION_INSTALL_DIR@/loom-runs@CMAKE_SHARED_MODULE_SUFFIX@")
    set_and_check(LOOM_SESSION_RUNTIME "@PACKAGE_LOOM_SESSION_INSTALL_DIR@/python")
endif()

check_required_components(loom)
