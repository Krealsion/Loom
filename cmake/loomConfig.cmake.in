@PACKAGE_INIT@

# Loom's consumer surface: loom::core, loom::switchboard, loom::terminal, loom::history,
# loom::bridge and, where it was built, loom::kernel, with the same spellings the in-tree ALIASes
# use, so a build against this package and one from source resolve the same names.

include("${CMAKE_CURRENT_LIST_DIR}/loomTargets.cmake")

# The weave-authoring surface: loom_weave_build_contract(<target>) (KERN-05). It ships in every
# package, one without loom::kernel included, because what a consumer can author is not gated on
# what an install can host; `if(TARGET loom::kernel)` is the question for hosting.
include("${CMAKE_CURRENT_LIST_DIR}/loom-weave.cmake")

# The programs this install can run, named for a consumer's tests and tools, never a link line:
# LOOM_HOST_PROGRAM, the installed `loom-host` (docs/guides/running-loom.md); LOOM_SESSION_TOOLS,
# TRUE where the session tooling was built (docs/guides/sessions.md); with it, LOOM_RUNS_ARTIFACT
# (the run manager a session host boots) and LOOM_SESSION_RUNTIME (the directory PYTHONPATH names
# for `loom_session`). Each path is checked as it is set, so a package missing one fails the
# consumer's configure in words.
set_and_check(LOOM_HOST_PROGRAM "@PACKAGE_LOOM_HOST_INSTALL_DIR@/loom-host@CMAKE_EXECUTABLE_SUFFIX@")
set(LOOM_SESSION_TOOLS @LOOM_SESSION_TOOLS_INSTALLED@)
if(LOOM_SESSION_TOOLS)
    set_and_check(LOOM_RUNS_ARTIFACT
        "@PACKAGE_LOOM_SESSION_INSTALL_DIR@/loom-runs@CMAKE_SHARED_MODULE_SUFFIX@")
    set_and_check(LOOM_SESSION_RUNTIME "@PACKAGE_LOOM_SESSION_INSTALL_DIR@/python")
endif()

check_required_components(loom)
