#
# The compiler cache's store of CI's Zengine stranger job: what that job and the hourly check
# (.github/workflows/stores.yml) ask of it. A store's key names what it was built against and the
# run that saved it:
#   ccache-zengine-stranger-<compiler>-<zengine>-<loom>-<run id>-<attempt>
# the compiler a digest of the compilers' bytes (16 hexadecimal digits), Zengine and Loom each the
# commit the run built (40). Exit 0 once it has answered, either way.
#   cmake -DZEN_STORE_DO=say -DZEN_STORE_KEY=<key> -DZEN_ZENGINE=<commit> -DZEN_LOOM=<commit>
#         [-DZEN_LOOM_BASE=<commit>] -P tests/ci_store.cmake
#   cmake -DZEN_STORE_DO=ask -DZEN_STORE_KEY=<key> -P tests/ci_store.cmake
#   cmake -DZEN_STORE_DO=newest -DZEN_ZENGINE=<commit> -DZEN_LOOM=<commit> -P tests/ci_store.cmake
#   cmake -DZEN_STORE_DO=self-test -P tests/ci_store.cmake
# `say` writes the job's summary lines (GITHUB_STEP_SUMMARY, and the log): which run saved the
# store the job restored (the key `actions/cache/restore` matched, empty when none) and whether its
# Zengine and its Loom are this run's; ZEN_LOOM_BASE is the commit a pull request's Loom is on.
# `ask` says whether the newest store (the key a lookup matched) was built against Zengine's
# `main` and Loom's `main` as they resolve now, and writes `level=true|false` to GITHUB_OUTPUT.
# `newest` says whether this run's store would still be the newest: its Zengine still Zengine's
# `main` and its Loom still Loom's. It writes `save=true` when both are, or when either cannot be
# resolved, so a lost answer keeps the save; else `save=false`, and a newer run saves.

cmake_minimum_required(VERSION 3.16)

set(ZEN_STORE_FAMILY "ccache-zengine-stranger-")
set(ZEN_STORE_ZENGINE_URL "https://github.com/Krealsion/Zengine.git")
set(ZEN_STORE_LOOM_URL "https://github.com/Krealsion/Loom.git")
set(ZEN_STORE_HEX40 "[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]")
set(ZEN_STORE_HEX40 "${ZEN_STORE_HEX40}${ZEN_STORE_HEX40}${ZEN_STORE_HEX40}${ZEN_STORE_HEX40}")
set(ZEN_STORE_HEX16 "[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]")
set(ZEN_STORE_HEX16 "${ZEN_STORE_HEX16}${ZEN_STORE_HEX16}")

# A key's Zengine, Loom and run, each empty when the key is no store of this family.
function(zen_store_read key out_zengine out_loom out_run)
    set(zengine "")
    set(loom "")
    set(run "")
    if(key MATCHES "^${ZEN_STORE_FAMILY}${ZEN_STORE_HEX16}-(${ZEN_STORE_HEX40})-(${ZEN_STORE_HEX40})-([0-9]+)-[0-9]+$")
        set(zengine "${CMAKE_MATCH_1}")
        set(loom "${CMAKE_MATCH_2}")
        set(run "${CMAKE_MATCH_3}")
    endif()
    set(${out_zengine} "${zengine}" PARENT_SCOPE)
    set(${out_loom} "${loom}" PARENT_SCOPE)
    set(${out_run} "${run}" PARENT_SCOPE)
endfunction()

# The summary's lines for the store a run restored.
function(zen_store_say key zengine loom loom_base server repository out)
    set(head "## Loom -> canonical Zengine stranger: the store it restored\n\n")
    if(key STREQUAL "")
        set(${out} "${head}No store was restored: every compile is a miss, and this build is cold.\n" PARENT_SCOPE)
        return()
    endif()
    zen_store_read("${key}" store_zengine store_loom run)
    if(run STREQUAL "")
        set(${out} "${head}The store `${key}` was restored, a key of no store this job saves.\n" PARENT_SCOPE)
        return()
    endif()
    set(link "${run}")
    if(NOT server STREQUAL "" AND NOT repository STREQUAL "")
        set(link "[${run}](${server}/${repository}/actions/runs/${run})")
    endif()
    string(SUBSTRING "${store_zengine}" 0 7 z)
    string(SUBSTRING "${store_loom}" 0 7 l)
    if(store_zengine STREQUAL zengine)
        set(zengine_words "Zengine `${z}`, this run's")
    else()
        string(SUBSTRING "${zengine}" 0 7 now)
        set(zengine_words "Zengine `${z}`, not this run's `${now}`")
    endif()
    if(store_loom STREQUAL loom)
        set(loom_words "Loom `${l}`, this run's")
    elseif(NOT loom_base STREQUAL "" AND store_loom STREQUAL loom_base)
        set(loom_words "Loom `${l}`, the `main` this change is on")
    else()
        string(SUBSTRING "${loom}" 0 7 now)
        set(loom_words "Loom `${l}`, not this run's `${now}`")
    endif()
    set(${out} "${head}The store run ${link} saved was restored, built against ${zengine_words}, and ${loom_words}.\n" PARENT_SCOPE)
endfunction()

# Whether the newest store is level with both mains: `level` TRUE or FALSE, and the words.
function(zen_store_ask key zengine_main loom_main out_level out_words)
    zen_store_read("${key}" store_zengine store_loom run)
    set(level FALSE)
    if(key STREQUAL "")
        set(words "no store on main, so it is rebuilt")
    elseif(run STREQUAL "")
        set(words "the newest store, ${key}, names no Zengine and Loom, so it is rebuilt")
    elseif(NOT store_zengine STREQUAL zengine_main)
        set(words "the newest store, run ${run}'s, was built against Zengine ${store_zengine}, behind Zengine's main ${zengine_main}, so it is rebuilt")
    elseif(NOT store_loom STREQUAL loom_main)
        set(words "the newest store, run ${run}'s, was built against Loom ${store_loom}, behind Loom's main ${loom_main}, so it is rebuilt")
    else()
        set(level TRUE)
        set(words "the newest store, run ${run}'s, was built against Zengine's main and Loom's main: level")
    endif()
    set(${out_level} ${level} PARENT_SCOPE)
    set(${out_words} "${words}" PARENT_SCOPE)
endfunction()

# Whether a run at `zengine` and `loom` saves its store, given each main as resolved now (empty
# when it could not be).
function(zen_store_newest zengine loom zengine_main loom_main out_save out_words)
    if(zengine_main STREQUAL "" OR loom_main STREQUAL "")
        set(save TRUE)
        set(words "a main could not be resolved, so the store is saved as before")
    elseif(NOT zengine_main STREQUAL zengine)
        set(save FALSE)
        set(words "Zengine's main is at ${zengine_main} now, past this run's ${zengine}: a run against it saves the store")
    elseif(NOT loom_main STREQUAL loom)
        set(save FALSE)
        set(words "Loom's main is at ${loom_main} now, past this run's ${loom}: the newer commit's run saves the store")
    else()
        set(save TRUE)
        set(words "this run's Zengine is Zengine's main and its Loom Loom's main: the store is saved")
    endif()
    set(${out_save} ${save} PARENT_SCOPE)
    set(${out_words} "${words}" PARENT_SCOPE)
endfunction()

function(zen_store_resolve url out)
    find_package(Git QUIET)
    set(sha "")
    if(GIT_EXECUTABLE)
        execute_process(COMMAND "${GIT_EXECUTABLE}" ls-remote "${url}" refs/heads/main
                        OUTPUT_VARIABLE said RESULT_VARIABLE rc ERROR_QUIET TIMEOUT 60)
        if(rc EQUAL 0 AND said MATCHES "^(${ZEN_STORE_HEX40})[ \t]")
            set(sha "${CMAKE_MATCH_1}")
        endif()
    endif()
    set(${out} "${sha}" PARENT_SCOPE)
endfunction()

function(zen_store_output name value)
    if(NOT "$ENV{GITHUB_OUTPUT}" STREQUAL "")
        file(APPEND "$ENV{GITHUB_OUTPUT}" "${name}=${value}\n")
    endif()
endfunction()

function(zen_store_commit name)
    if(NOT "${${name}}" MATCHES "^${ZEN_STORE_HEX40}$")
        message(FATAL_ERROR "ci-store: ${name} is a commit, 40 hexadecimal digits, not '${${name}}'")
    endif()
endfunction()

if(NOT DEFINED ZEN_STORE_DO)
    message(FATAL_ERROR "ci-store: pass -DZEN_STORE_DO=say, ask, newest or self-test")
endif()

if(ZEN_STORE_DO STREQUAL "self-test")
    set(failures "")
    set(passed 0)
    macro(zen_store_expect case got want)
        if("${got}" STREQUAL "${want}")
            math(EXPR passed "${passed} + 1")
        else()
            string(APPEND failures "  - ${case}: wanted '${want}', got '${got}'\n")
        endif()
    endmacro()
    macro(zen_store_expect_has case text needle)
        string(FIND "${text}" "${needle}" at)
        if(at EQUAL -1)
            string(APPEND failures "  - ${case}: wanted '${needle}' in: ${text}\n")
        else()
            math(EXPR passed "${passed} + 1")
        endif()
    endmacro()
    set(z 2728c4d633333333333333333333333333333333)
    set(z2 f9193b0a44444444444444444444444444444444)
    set(l 6314498111111111111111111111111111111111)
    set(l2 9c9ee9a222222222222222222222222222222222)
    set(key "${ZEN_STORE_FAMILY}3dd0a4ce9331d7bf-${z}-${l}-45508015165-1")
    set(old "${ZEN_STORE_FAMILY}3dd0a4ce9331d7bf-${z2}-${l2}-45480059320-2")

    zen_store_read("${key}" rz rl rr)
    zen_store_expect("a key's commits and run" "${rz} ${rl} ${rr}" "${z} ${l} 45508015165")
    zen_store_read("ccache-linux-debug-3dd0a4ce9331d7bf-${l}-1-1" rz rl rr)
    zen_store_expect("another family's key" "${rr}" "")

    zen_store_say("${key}" "${z}" "${l}" "" "https://github.com" "o/r" said)
    zen_store_expect_has("said, both this run's" "${said}"
                         "Zengine `2728c4d`, this run's, and Loom `6314498`, this run's")
    zen_store_expect_has("said, the run linked" "${said}"
                         "(https://github.com/o/r/actions/runs/45508015165)")
    zen_store_say("${old}" "${z}" "${l}" "${l2}" "" "" said)
    zen_store_expect_has("said, an older Zengine, on the main this change is on" "${said}"
        "Zengine `f9193b0`, not this run's `2728c4d`, and Loom `9c9ee9a`, the `main` this change is on")
    zen_store_say("${old}" "${z}" "${l}" "" "" "" said)
    zen_store_expect_has("said, an older Loom" "${said}" "Loom `9c9ee9a`, not this run's `6314498`")
    zen_store_say("" "${z}" "${l}" "" "" "" said)
    zen_store_expect_has("said, nothing restored" "${said}" "No store was restored")

    zen_store_ask("${key}" "${z}" "${l}" level words)
    zen_store_expect("asked, level with both mains" "${level}" "TRUE")
    zen_store_ask("${key}" "${z2}" "${l}" level words)
    zen_store_expect("asked, Zengine's main moved" "${level}" "FALSE")
    zen_store_ask("${key}" "${z}" "${l2}" level words)
    zen_store_expect("asked, Loom's main moved" "${level}" "FALSE")
    zen_store_ask("" "${z}" "${l}" level words)
    zen_store_expect("asked, no store" "${level}" "FALSE")

    zen_store_newest("${z}" "${l}" "${z}" "${l}" save words)
    zen_store_expect("newest, both mains this run's" "${save}" "TRUE")
    zen_store_newest("${z}" "${l}" "${z2}" "${l}" save words)
    zen_store_expect("newest, Zengine's main moved past" "${save}" "FALSE")
    zen_store_newest("${z}" "${l}" "${z}" "${l2}" save words)
    zen_store_expect("newest, Loom's main moved past" "${save}" "FALSE")
    zen_store_newest("${z}" "${l}" "" "${l2}" save words)
    zen_store_expect("newest, a main unresolved" "${save}" "TRUE")

    if(NOT failures STREQUAL "")
        message(FATAL_ERROR "ci-store: self-test FAILED\n${failures}")
    endif()
    message(STATUS "ci-store: self-test passed -- ${passed} cases")
    return()
endif()

if(ZEN_STORE_DO STREQUAL "say")
    zen_store_commit(ZEN_ZENGINE)
    zen_store_commit(ZEN_LOOM)
    if(NOT DEFINED ZEN_STORE_KEY)
        set(ZEN_STORE_KEY "")
    endif()
    if(NOT DEFINED ZEN_LOOM_BASE)
        set(ZEN_LOOM_BASE "")
    endif()
    zen_store_say("${ZEN_STORE_KEY}" "${ZEN_ZENGINE}" "${ZEN_LOOM}" "${ZEN_LOOM_BASE}"
                  "$ENV{GITHUB_SERVER_URL}" "$ENV{GITHUB_REPOSITORY}" said)
    message(STATUS "ci-store: ${said}")
    if(NOT "$ENV{GITHUB_STEP_SUMMARY}" STREQUAL "")
        file(APPEND "$ENV{GITHUB_STEP_SUMMARY}" "${said}")
    endif()
elseif(ZEN_STORE_DO STREQUAL "ask")
    if(NOT DEFINED ZEN_STORE_KEY)
        set(ZEN_STORE_KEY "")
    endif()
    zen_store_resolve("${ZEN_STORE_ZENGINE_URL}" zengine_main)
    zen_store_resolve("${ZEN_STORE_LOOM_URL}" loom_main)
    if(zengine_main STREQUAL "" OR loom_main STREQUAL "")
        message(STATUS "ci-store: a main could not be resolved, so the store is rebuilt")
        zen_store_output(level false)
        return()
    endif()
    zen_store_ask("${ZEN_STORE_KEY}" "${zengine_main}" "${loom_main}" level words)
    message(STATUS "ci-store: ${ZEN_STORE_FAMILY}: ${words}")
    if(level)
        zen_store_output(level true)
    else()
        zen_store_output(level false)
    endif()
elseif(ZEN_STORE_DO STREQUAL "newest")
    zen_store_commit(ZEN_ZENGINE)
    zen_store_commit(ZEN_LOOM)
    zen_store_resolve("${ZEN_STORE_ZENGINE_URL}" zengine_main)
    zen_store_resolve("${ZEN_STORE_LOOM_URL}" loom_main)
    zen_store_newest("${ZEN_ZENGINE}" "${ZEN_LOOM}" "${zengine_main}" "${loom_main}" save words)
    message(STATUS "ci-store: ${words}")
    if(save)
        zen_store_output(save true)
    else()
        zen_store_output(save false)
    endif()
else()
    message(FATAL_ERROR "ci-store: ZEN_STORE_DO is say, ask, newest or self-test, not '${ZEN_STORE_DO}'")
endif()
