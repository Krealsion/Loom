#
# The `census` entry: every row of tests/census.txt held by the tree, exactly, in either direction,
# and a row marked `falls` never raised against the base (ZEN_BASE, else the merge-base with
# origin/main). Its rows and their kinds are the census's own header.
#   cmake -P tests/check_census.cmake                 (from the repository root, or -DZEN_REPO=<repo>)
#   cmake -DZEN_CENSUS_WRITE=<file> -P tests/check_census.cmake   (the census as the tree stands)

cmake_minimum_required(VERSION 3.16)

if(NOT DEFINED ZEN_REPO OR ZEN_REPO STREQUAL "")
    set(ZEN_REPO "${CMAKE_CURRENT_LIST_DIR}/..")
endif()
get_filename_component(ZEN_REPO "${ZEN_REPO}" ABSOLUTE)
if(NOT EXISTS "${ZEN_REPO}/AGENTS.md" OR NOT EXISTS "${ZEN_REPO}/tests/census.txt")
    message(FATAL_ERROR "census: '${ZEN_REPO}' is not this repository's root (no AGENTS.md and "
                        "tests/census.txt). Pass -DZEN_REPO=<repository root>.")
endif()

set(ZEN_CENSUS_KINDS lines members doors)

# ---- the readings, one place each so the self-test exercises the real ones -------------------

# The census's rows: `<kind> <subject> <count> [falls]`, `#` a comment. Each malformed row is a
# problem, never a row read some other way. A row is kept as `<kind>|<subject>|<count>|<mark>`.
function(zen_census_parse text prefix)
    string(REPLACE "\r" "" text "${text}")
    string(REPLACE ";" "," text "${text}")
    string(REPLACE "\n" ";" lines "${text}")
    set(rows "")
    set(problems "")
    set(n 0)
    foreach(line IN LISTS lines)
        math(EXPR n "${n} + 1")
        if(line MATCHES "^[ \t]*(#|$)")
            continue()
        elseif(line MATCHES "^([a-z]+)[ \t]+([A-Za-z0-9_./-]+)[ \t]+([0-9]+)([ \t]+falls)?[ \t]*$")
            # The captures are copied before the loop below matches again.
            set(kind "${CMAKE_MATCH_1}")
            set(key "${CMAKE_MATCH_1}|${CMAKE_MATCH_2}")
            set(count "${CMAKE_MATCH_3}")
            set(mark "")
            if(CMAKE_MATCH_4)
                set(mark falls)
            endif()
            if(NOT kind IN_LIST ZEN_CENSUS_KINDS)
                list(APPEND problems "census.txt:${n}: a row is `lines`, `members` or `doors`, not `${kind}`")
                continue()
            endif()
            foreach(row IN LISTS rows)
                if(row MATCHES "^([^|]+[|][^|]+)[|]" AND CMAKE_MATCH_1 STREQUAL key)
                    list(APPEND problems "census.txt:${n}: a second row for ${key}")
                endif()
            endforeach()
            list(APPEND rows "${key}|${count}|${mark}")
        else()
            list(APPEND problems "census.txt:${n}: not a row: `${line}` (`<kind> <subject> <count> [falls]`)")
        endif()
    endforeach()
    set(${prefix}_ROWS "${rows}" PARENT_SCOPE)
    set(${prefix}_PROBLEMS "${problems}" PARENT_SCOPE)
endfunction()

# The lines of a text: its line breaks, and one more for a last line with none.
function(zen_census_lines text out)
    string(REPLACE "\r" "" text "${text}")
    string(REGEX MATCHALL "\n" breaks "${text}")
    list(LENGTH breaks n)
    if(NOT text STREQUAL "" AND NOT text MATCHES "\n$")
        math(EXPR n "${n} + 1")
    endif()
    set(${out} ${n} PARENT_SCOPE)
endfunction()

# The member functions of `class` one source defines: each line that starts a definition (it
# begins with neither space, `#` nor `/`) naming `<class>::<name>(`, a nested class's members not
# among them.
function(zen_census_members text class out)
    string(REPLACE "\r" "" text "${text}")
    string(REPLACE ";" "," text "${text}")
    string(REPLACE "\n" ";" lines "${text}")
    set(n 0)
    foreach(line IN LISTS lines)
        if(line MATCHES "^[ \t#/]")
            continue()
        endif()
        if(line MATCHES "^${class}::[A-Za-z_~][A-Za-z0-9_]*[(]"
           OR line MATCHES "[^A-Za-z0-9_:]${class}::[A-Za-z_~][A-Za-z0-9_]*[(]")
            math(EXPR n "${n} + 1")
        endif()
    endforeach()
    set(${out} ${n} PARENT_SCOPE)
endfunction()

# The doors of `struct` in a C header: its function-pointer fields, `(*name)(`, between
# `typedef struct <struct> {` and its closing `} <struct>;`.
function(zen_census_doors text struct out)
    string(REPLACE "\r" "" text "${text}")
    set(n -1)
    string(FIND "${text}" "typedef struct ${struct} {" at)
    if(at GREATER -1)
        string(SUBSTRING "${text}" ${at} -1 rest)
        string(FIND "${rest}" "} ${struct};" end)
        if(end GREATER -1)
            string(SUBSTRING "${rest}" 0 ${end} body)
            string(REGEX MATCHALL "\\(\\*[A-Za-z_][A-Za-z0-9_]*\\)[ \t]*\\(" doors "${body}")
            list(LENGTH doors n)
        endif()
    endif()
    set(${out} ${n} PARENT_SCOPE)
endfunction()

# The judgement: `found` and `rows` are lists of `<kind>|<subject>|<count>[|<mark>]`, `base` the
# rows at the base (`-` when there is none to read). Its problems name each row to look at.
function(zen_census_judge found rows base out_problems)
    set(problems "")
    foreach(f IN LISTS found)
        string(REPLACE "|" ";" fp "${f}")
        list(GET fp 0 kind)
        list(GET fp 1 subject)
        list(GET fp 2 count)
        set(pinned "")
        set(mark "")
        foreach(r IN LISTS rows)
            string(REPLACE "|" ";" rp "${r}")
            list(GET rp 0 rkind)
            list(GET rp 1 rsubject)
            if(rkind STREQUAL kind AND rsubject STREQUAL subject)
                list(GET rp 2 pinned)
                list(LENGTH rp rn)
                if(rn GREATER 3)
                    list(GET rp 3 mark)
                endif()
            endif()
        endforeach()
        if(pinned STREQUAL "")
            list(APPEND problems "${kind} ${subject}: the tree holds ${count}, and no row pins it")
            continue()
        endif()
        if(NOT pinned EQUAL count)
            list(APPEND problems "${kind} ${subject}: the tree holds ${count}, and its row says ${pinned}: the row is set to what the tree holds")
        endif()
        if(mark STREQUAL "falls" AND NOT base STREQUAL "-")
            set(was "")
            foreach(b IN LISTS base)
                string(REPLACE "|" ";" bp "${b}")
                list(GET bp 0 bkind)
                list(GET bp 1 bsubject)
                if(bkind STREQUAL kind AND bsubject STREQUAL subject)
                    list(GET bp 2 was)
                endif()
            endforeach()
            if(NOT was STREQUAL "" AND pinned GREATER was)
                list(APPEND problems "${kind} ${subject} is marked to only fall, and it rose from ${was} at the base to ${pinned}")
            endif()
        endif()
    endforeach()
    foreach(r IN LISTS rows)
        if(r MATCHES "^([^|]+)[|]([^|]+)[|]")
            set(rkind "${CMAKE_MATCH_1}")
            set(rsubject "${CMAKE_MATCH_2}")
            set(held 0)
            foreach(f IN LISTS found)
                if(f MATCHES "^([^|]+)[|]([^|]+)[|]" AND CMAKE_MATCH_1 STREQUAL rkind
                   AND CMAKE_MATCH_2 STREQUAL rsubject)
                    set(held 1)
                endif()
            endforeach()
            if(NOT held)
                list(APPEND problems "${rkind} ${rsubject}: its row names nothing the tree holds: the row goes, or names what it counts")
            endif()
        endif()
    endforeach()
    set(${out_problems} "${problems}" PARENT_SCOPE)
endfunction()

# ---- the self-test: make it say NO, and make it say YES ----------------------------------------

set(st_failed "")
zen_census_lines("a\nb\nc\n" st_n)
zen_census_lines("a\nb" st_m)
if(NOT st_n EQUAL 3 OR NOT st_m EQUAL 2)
    list(APPEND st_failed "three lines read as ${st_n} and two without a last break as ${st_m}")
endif()
zen_census_members("int B::f() {\n}\nB::B() {}\nB::C* B::g(int) {\n  B::h();\n}\n// B::i()\nvoid B::C::j() {}\nint AB::k() {}\n" B st_n)
if(NOT st_n EQUAL 3)
    list(APPEND st_failed "the members of B read as ${st_n}, want 3 (f, B and g; not a call, a comment, a nested class's or AB's)")
endif()
zen_census_doors("typedef struct T {\n    uint32_t size;\n    void* ctx;\n    int (*a)(void* c);\n    void (*b) (int);\n} T;\ntypedef struct U {\n    int (*c)(void);\n} U;\n" T st_n)
zen_census_doors("typedef struct V { int x; } W;" V st_m)
if(NOT st_n EQUAL 2 OR NOT st_m EQUAL -1)
    list(APPEND st_failed "the doors of T read as ${st_n} (want 2, not U's), and of an unclosed V as ${st_m} (want -1)")
endif()
zen_census_parse("# c\nlines a/b.cpp 10 falls\ndoors T 2\nfiles x 1\nbad row\nlines a/b.cpp 9\n" st)
list(LENGTH st_PROBLEMS st_np)
if(NOT st_ROWS STREQUAL "lines|a/b.cpp|10|falls;doors|T|2|;lines|a/b.cpp|9|" OR NOT st_np EQUAL 3)
    list(APPEND st_failed "the census read as rows '${st_ROWS}' and ${st_np} problem(s), want three rows and three problems (an unknown kind, a bad row, a second row)")
endif()
set(st_rows "lines|a/b.cpp|10|falls;doors|T|2|")
zen_census_judge("lines|a/b.cpp|10;doors|T|2" "${st_rows}" "lines|a/b.cpp|10;doors|T|1" st_p)
if(st_p)
    list(APPEND st_failed "the tree its rows pin read as '${st_p}', want no problem (an unmarked row may rise)")
endif()
zen_census_judge("lines|a/b.cpp|11;doors|T|2" "${st_rows}" "-" st_p)
if(NOT st_p MATCHES "holds 11, and its row says 10")
    list(APPEND st_failed "a count that moved read as '${st_p}'")
endif()
zen_census_judge("lines|a/b.cpp|10;doors|T|2;members|S|4" "${st_rows}" "-" st_p)
if(NOT st_p MATCHES "members S: the tree holds 4, and no row pins it")
    list(APPEND st_failed "a number no row pins read as '${st_p}'")
endif()
zen_census_judge("doors|T|2" "${st_rows}" "-" st_p)
if(NOT st_p MATCHES "lines a/b[.]cpp: its row names nothing")
    list(APPEND st_failed "a row the tree no longer holds read as '${st_p}'")
endif()
zen_census_judge("lines|a/b.cpp|10;doors|T|2" "${st_rows}" "lines|a/b.cpp|9;doors|T|2" st_p)
list(LENGTH st_p st_pn)
if(NOT st_p MATCHES "marked to only fall, and it rose from 9 at the base to 10" OR NOT st_pn EQUAL 1)
    list(APPEND st_failed "a marked row raised against its base read as '${st_p}'")
endif()
if(st_failed)
    string(REPLACE ";" "\n  " shown "${st_failed}")
    message(FATAL_ERROR "census: SELF-TEST FAILED -- the readings would judge the tree wrongly:\n  ${shown}")
endif()

# ---- the census and the base ------------------------------------------------------------------

file(READ "${ZEN_REPO}/tests/census.txt" census_text)
zen_census_parse("${census_text}" census)
set(problems ${census_PROBLEMS})

# The base: what the marked rows are held to. With no Git, no base or no census at it, nothing
# is held and the check says so.
set(base_rows "-")
set(base_said "no base was read")
find_program(ZEN_CENSUS_GIT git)
if(ZEN_CENSUS_GIT)
    if(NOT DEFINED ZEN_BASE OR ZEN_BASE STREQUAL "")
        execute_process(COMMAND "${ZEN_CENSUS_GIT}" -C "${ZEN_REPO}" merge-base HEAD origin/main
                        RESULT_VARIABLE rc OUTPUT_VARIABLE ZEN_BASE ERROR_QUIET OUTPUT_STRIP_TRAILING_WHITESPACE)
        if(NOT rc EQUAL 0)
            set(ZEN_BASE "")
            set(base_said "no base was read: `git merge-base HEAD origin/main` failed, so no marked row is held to one (ZEN_BASE names one)")
        endif()
    endif()
    if(NOT ZEN_BASE STREQUAL "")
        execute_process(COMMAND "${ZEN_CENSUS_GIT}" -C "${ZEN_REPO}" show "${ZEN_BASE}:tests/census.txt"
                        RESULT_VARIABLE rc OUTPUT_VARIABLE base_text ERROR_QUIET)
        if(rc EQUAL 0)
            zen_census_parse("${base_text}" base)
            set(base_rows "${base_ROWS}")
            set(base_said "marked rows held to the base ${ZEN_BASE}")
        else()
            set(base_said "the base ${ZEN_BASE} holds no tests/census.txt, so no marked row is held to one")
        endif()
    endif()
else()
    set(base_said "no base was read: no git was found, so no marked row is held to one")
endif()

# ---- the tree: each row's subject counted ---------------------------------------------------

file(GLOB_RECURSE zen_census_sources RELATIVE "${ZEN_REPO}" "${ZEN_REPO}/src/*.cpp"
     "${ZEN_REPO}/src/*.hpp")
list(LENGTH zen_census_sources source_count)
if(source_count EQUAL 0)
    message(FATAL_ERROR "census: no source was found under src/; an empty tree would pass")
endif()
set(found "")
foreach(r IN LISTS census_ROWS)
    string(REPLACE "|" ";" rp "${r}")
    list(GET rp 0 kind)
    list(GET rp 1 subject)
    if(kind STREQUAL "lines")
        if(EXISTS "${ZEN_REPO}/${subject}" AND NOT IS_DIRECTORY "${ZEN_REPO}/${subject}")
            file(READ "${ZEN_REPO}/${subject}" text)
            zen_census_lines("${text}" n)
            list(APPEND found "lines|${subject}|${n}")
        endif()
    elseif(kind STREQUAL "members")
        set(n 0)
        foreach(src IN LISTS zen_census_sources)
            file(READ "${ZEN_REPO}/${src}" text)
            zen_census_members("${text}" "${subject}" here)
            math(EXPR n "${n} + ${here}")
        endforeach()
        if(n GREATER 0)
            list(APPEND found "members|${subject}|${n}")
        endif()
    elseif(kind STREQUAL "doors")
        file(READ "${ZEN_REPO}/include/zen/kernel/abi.h" text)
        zen_census_doors("${text}" "${subject}" n)
        if(n GREATER -1)
            list(APPEND found "doors|${subject}|${n}")
        endif()
    endif()
endforeach()

# ---- write mode: the census as the tree stands ------------------------------------------------

if(DEFINED ZEN_CENSUS_WRITE)
    string(REPLACE "\r" "" census_text_lf "${census_text}")
    string(REGEX MATCH "^(#[^\n]*\n)+" out "${census_text_lf}")
    string(APPEND out "\n")
    foreach(r IN LISTS census_ROWS)
        string(REPLACE "|" ";" rp "${r}")
        list(GET rp 0 kind)
        list(GET rp 1 subject)
        list(LENGTH rp rn)
        set(mark "")
        if(rn GREATER 3)
            list(GET rp 3 mark)
        endif()
        foreach(f IN LISTS found)
            string(REPLACE "|" ";" fp "${f}")
            list(GET fp 0 fkind)
            list(GET fp 1 fsubject)
            if(fkind STREQUAL kind AND fsubject STREQUAL subject)
                list(GET fp 2 count)
                if(mark STREQUAL "falls")
                    string(APPEND out "${kind} ${subject} ${count} falls\n")
                else()
                    string(APPEND out "${kind} ${subject} ${count}\n")
                endif()
            endif()
        endforeach()
    endforeach()
    # LF on every host, as the census is committed.
    file(CONFIGURE OUTPUT "${ZEN_CENSUS_WRITE}" CONTENT "${out}" @ONLY NEWLINE_STYLE UNIX)
    message(STATUS "census: wrote the census as the tree stands to ${ZEN_CENSUS_WRITE}")
endif()

# ---- the judgement ------------------------------------------------------------------------------

zen_census_judge("${found}" "${census_ROWS}" "${base_rows}" judged)
list(APPEND problems ${judged})
list(LENGTH census_ROWS pinned_count)
string(REPLACE ";" ", " shown_found "${found}")
string(REPLACE "|" " " shown_found "${shown_found}")
message(STATUS "census: ${source_count} sources read under src/; ${pinned_count} rows pinned "
               "(${shown_found}); ${base_said}")
if(problems)
    list(LENGTH problems problem_count)
    string(REPLACE ";" "\n  " shown "${problems}")
    message(FATAL_ERROR "census FAILED: ${problem_count} problem(s):\n  ${shown}")
endif()
message(STATUS "census: PASSED -- every number the census pins is the tree's, and no row "
               "marked to fall rose")
