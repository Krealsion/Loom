    message(FATAL_ERROR "code-values: ${ZEN_VALUES_REGISTRY} registers nothing; an empty registry is a red, not a pass")
endif()
set(problems "")
# In passes, so a value defined from another file's registered constant waits for it; what is
# still unread after the last pass is a finding.
set(unread "${ids}")
foreach(pass 1 2 3 4)
set(unread_after "")
foreach(id IN LISTS unread)
    get_property(owner GLOBAL PROPERTY "zen_values_owner_${id}")
    get_property(symbol GLOBAL PROPERTY "zen_values_symbol_${id}")
    if(NOT EXISTS "${ZEN_REPO}/${owner}")
        if(pass EQUAL 1)
            list(APPEND problems "${ZEN_VALUES_REGISTRY}: `${id}`'s owner ${owner} does not exist")
        endif()
        continue()
    endif()
    file(READ "${ZEN_REPO}/${owner}" code)
    zen_values_swap("${code}" code)
    # Each owner's comments go by its own language's rule: a CMake file's `/*` is text, not a
    # comment, and reading it as one would swallow the file.
    set(ZEN_VALUES_OWNER_IS_PYTHON OFF)
    if(owner MATCHES "[.]py$")
        set(ZEN_VALUES_OWNER_IS_PYTHON ON)
        string(REGEX REPLACE "#[^\n]*" "" code "${code}")
    elseif(owner MATCHES "[.]cmake$|CMakeLists[.]txt$")
        string(REGEX REPLACE "(^|\n)[ \t]*#[^\n]*" "\\1" code "${code}")
    else()
        string(REGEX REPLACE "/[*]([^*]|[*]+[^*/])*[*]+/" "" code "${code}")
        string(REGEX REPLACE "//[^\n]*" "" code "${code}")
    endif()
    zen_values_declaration("${code}" "${symbol}" expr why)
    if(why STREQUAL "")
        zen_values_evaluate("${expr}" "${code}" 0 value why)
    endif()
    if(NOT why STREQUAL "")
        list(APPEND unread_after "${id}")
        if(pass EQUAL 4)
            list(APPEND problems "${ZEN_VALUES_REGISTRY}: `${id}`: ${owner} ${why}")
        endif()
        continue()
    endif()
    set_property(GLOBAL PROPERTY "zen_values_value_${id}" "${value}")
    set_property(GLOBAL PROPERTY "zen_values_by_symbol_${symbol}" "${value}")
endforeach()
