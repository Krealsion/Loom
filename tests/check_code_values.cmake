# ---- the population: every current-facing document and comment -------------------------

set(documents "")
set(sources "")
file(GLOB top RELATIVE "${ZEN_REPO}" "${ZEN_REPO}/*")
foreach(entry IN LISTS top)
    set(skip 0)
    foreach(rx IN LISTS ZEN_VALUES_EXCLUDE)
        if(entry MATCHES "${rx}" OR "${entry}/" MATCHES "${rx}")
            set(skip 1)
        endif()
    endforeach()
    if(skip)
        continue()
    endif()
    if(IS_DIRECTORY "${ZEN_REPO}/${entry}")
        file(GLOB_RECURSE found RELATIVE "${ZEN_REPO}" "${ZEN_REPO}/${entry}/*")
    else()
        set(found "${entry}")
    endif()
    foreach(rel IN LISTS found)
        set(skip 0)
        foreach(rx IN LISTS ZEN_VALUES_EXCLUDE)
            if(rel MATCHES "${rx}")
                set(skip 1)
            endif()
        endforeach()
        if(skip)
            continue()
        endif()
        get_filename_component(name "${rel}" NAME)
        if(name MATCHES "[.]md$")
            list(APPEND documents "${rel}")
            continue()
        endif()
        foreach(glob IN LISTS ZEN_VALUES_SOURCE_GLOBS)
            string(REPLACE "." "[.]" g "${glob}")
            string(REPLACE "*" ".*" g "${g}")
            if(name MATCHES "^${g}$")
                list(APPEND sources "${rel}")
                break()
            endif()
        endforeach()
    endforeach()
endforeach()
list(SORT documents)
list(SORT sources)
list(LENGTH documents document_count)
list(LENGTH sources source_count)
if(document_count EQUAL 0 OR source_count EQUAL 0)
    message(FATAL_ERROR "code-values: ${document_count} documents and ${source_count} sources found under "
                        "${ZEN_REPO}; an empty population is a red, not a pass")
endif()

# The words that bring a value into a text: its name, and each registered spelling's fixed part.
# A file holding none of them is not read line by line for that value.
foreach(id IN LISTS ids)
    set(terms "")
    zen_values_text_name("${id}" name)
    if(NOT name STREQUAL "")
        list(APPEND terms "${name}")
    endif()
    foreach(kind claim mention)
        get_property(spellings GLOBAL PROPERTY "zen_values_${kind}_${id}")
        foreach(spelling IN LISTS spellings)
            string(REGEX REPLACE "\\{[A-Za-z0-9]*\\}.*$" "" head "${spelling}")
            string(STRIP "${head}" head)
            if(head STREQUAL "")
                string(REGEX REPLACE "^.*\\{[A-Za-z0-9]*\\}" "" head "${spelling}")
                string(STRIP "${head}" head)
            endif()
            list(APPEND terms "${head}")
        endforeach()
    endforeach()
    set_property(GLOBAL PROPERTY "zen_values_terms_${id}" "${terms}")
endforeach()
# What may be a test count, cheaply: a digit beside a word a count is reported with.
set(ZEN_VALUES_COUNT_HINT "[0-9]/[0-9]|[0-9] of [0-9]|PASSED [0-9]|[0-9] (test cases|cases|assertions|CTest entries|mutations)")

set(marker_count 0)
set(copy_count 0)
set(count_count 0)
set(written_files "")
foreach(rel IN LISTS documents sources)
    file(READ "${ZEN_REPO}/${rel}" raw)
    zen_values_swap("${raw}" text)
    set(is_doc 0)
    if(rel MATCHES "[.]md$")
        set(is_doc 1)
    endif()
    set(held "")
    if(is_doc)
        string(FIND "${text}" "<!-- value " any_marker)
        if(NOT any_marker EQUAL -1)
            zen_values_markers("${rel}" "${text}" "${ZEN_VALUES_WRITE}" found held new_text)
            list(APPEND problems ${found})
            get_property(k GLOBAL PROPERTY zen_values_checked)
            set(marker_count "${k}")
            if(ZEN_VALUES_WRITE AND NOT new_text STREQUAL text)
                zen_values_show("${new_text}" out)
                file(WRITE "${ZEN_REPO}/${rel}" "${out}")
                list(APPEND written_files "${rel}")
                set(text "${new_text}")
            endif()
        endif()
    endif()
    # The values this file brings in, and whether it may report a count.
    set(file_ids "")
    set(file_terms "")
    foreach(id IN LISTS ids)
        get_property(terms GLOBAL PROPERTY "zen_values_terms_${id}")
        foreach(term IN LISTS terms)
            string(FIND "${text}" "${term}" at)
            if(NOT at EQUAL -1)
                list(APPEND file_ids "${id}")
                list(APPEND file_terms ${terms})
                break()
            endif()
        endforeach()
    endforeach()
    set(may_count 0)
    if(text MATCHES "${ZEN_VALUES_COUNT_HINT}")
        set(may_count 1)
    endif()
    if(NOT file_ids AND NOT may_count)
        continue()
    endif()
    if(is_doc)
        string(REPLACE "\n" ";" doc_lines "${text}")
        set(entries "")
        set(n 0)
        foreach(l IN LISTS doc_lines)
            math(EXPR n "${n} + 1")
            list(APPEND entries "${n}|${l}")
        endforeach()
    else()
        zen_values_comments("${rel}" "${text}" entries)
    endif()
    set(paragraph "")
    set(paragraph_counts "")
    set(last 0)
    foreach(entry IN LISTS entries ITEMS "@END@")
        if(entry STREQUAL "@END@")
            set(n -1)
            set(l "")
        else()
            string(REGEX MATCH "^([0-9]+)[|](.*)$" _ "${entry}")
            set(n "${CMAKE_MATCH_1}")
            set(l "${CMAKE_MATCH_2}")
        endif()
        # A paragraph ends at a blank line or, in a source, where the comment lines stop; its
        # counts are judged with the whole paragraph.
        string(STRIP "${l}" stripped)
        math(EXPR gap "${n} - ${last}")
        if(stripped STREQUAL "" OR n EQUAL -1 OR (NOT is_doc AND gap GREATER 1))
            if(NOT paragraph_counts STREQUAL "")
                zen_values_attributed("${paragraph}" ok)
                if(NOT ok)
                    list(APPEND problems ${paragraph_counts})
                    list(LENGTH paragraph_counts k)
                    math(EXPR count_count "${count_count} + ${k}")
                endif()
            endif()
            set(paragraph "")
            set(paragraph_counts "")
            if(stripped STREQUAL "" OR n EQUAL -1)
                set(last "${n}")
                continue()
            endif()
        endif()
        set(last "${n}")
        string(APPEND paragraph " ${l}")
        set(near 0)
        foreach(term IN LISTS file_terms)
            string(FIND "${l}" "${term}" at)
            if(NOT at EQUAL -1)
                set(near 1)
                break()
            endif()
        endforeach()
        if(near OR (may_count AND l MATCHES "${ZEN_VALUES_COUNT_HINT}"))
            string(REGEX REPLACE "<!-- value [^>]*-->[^<]*<!-- /value -->" "@" bare "${l}")
            string(REGEX REPLACE "<!-- value [^>]* in \"[^\"]*\" -->" "" bare "${bare}")
        endif()
        if(near)
            set(line_held "")
            foreach(h IN LISTS held)
                if(h MATCHES "^${n}[|](.*)$")
                    list(APPEND line_held "${CMAKE_MATCH_1}")
                endif()
            endforeach()
            zen_values_unmarked("${rel}:${n}" "${bare}" "${file_ids}" "${line_held}" found)
            list(LENGTH found k)
            math(EXPR copy_count "${copy_count} + ${k}")
            list(APPEND problems ${found})
        endif()
        if(may_count AND l MATCHES "${ZEN_VALUES_COUNT_HINT}")
            zen_values_count("${bare}" c)
            if(NOT c STREQUAL "")
                zen_values_show("${c}" c)
                list(APPEND paragraph_counts "${rel}:${n}: a test count (\"${c}\") outside the population files names no commit and command that measured it -- name both beside it, or leave the number out")
            endif()
        endif()
    endforeach()
endforeach()

message(STATUS "code-values: ${id_count} values registered and read from their owners; "
               "${document_count} documents and ${source_count} sources read; ${marker_count} markers")
if(written_files)
    string(REPLACE ";" ", " shown "${written_files}")
    message(STATUS "code-values: rewrote the markers of ${shown}")
endif()
if(problems)
    list(LENGTH problems problem_count)
    string(REPLACE ";" "\n  " shown "${problems}")
    zen_values_show("${shown}" shown)
    message(FATAL_ERROR "code-values: ${problem_count} findings:\n  ${shown}")
endif()
message(STATUS "code-values: PASSED -- every marker says its owner's value, and no known value is copied unmarked")
